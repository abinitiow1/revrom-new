# Cloudflare Turnstile - Bot Verification
# Get these from: https://dash.cloudflare.com/ > Turnstile > Sites
# VITE_ prefix = public, visible in browser
# No prefix = private, server-only

# Public Site Key (safe to expose in client code)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# IMPORTANT: Server Secret Key (NEVER expose this in client code)
# Only needed for server-side verification in production/preview
# Set this in Vercel Project Settings > Environment Variables > Server Only
# DO NOT add VITE_ prefix to this variable!
# TURNSTILE_SECRET_KEY=0x4AAA...

# Hostname allow-list enforced on the server after Turnstile verification.
# Must match the hostname returned by Cloudflare (exact match, no wildcards).
# Example: TURNSTILE_EXPECTED_HOSTNAMES="revrom.in,www.revrom.in,revrom.vercel.app"
TURNSTILE_EXPECTED_HOSTNAMES=localhost

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase admin credentials (required by /api/* routes for rate limiting + forms)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Geoapify API (for location features)
GEOAPIFY_API_KEY=your-geoapify-key

# Data Mode: 'local' (default in dev) or 'supabase' (production)
VITE_DATA_MODE=local

# Optional: protects /api/health (recommended in production)
HEALTH_CHECK_SECRET=your-random-secret
